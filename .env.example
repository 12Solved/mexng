DATABASE_URL=postgresql+psycopg2://{USER}:{PASS}@localhost/{DB_NAME}

# PostgreSQL Configuration (for Docker)
POSTGRES_USER={USER}
POSTGRES_PASSWORD={PASS}
POSTGRES_DB={DB_NAME}

# Email Provider (imap or glob)
EMAIL_PROVIDER=imap

# Base path for the frontend (must have leading and trailing slash)
# Use / to serve from the root, or /subdir/ to serve from a subdirectory
# Example: VITE_BASE_PATH=/something/ -> app lives at www.example.com/something/
VITE_BASE_PATH=/{something}/

# IMAP Configuration (if using imap provider)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_USE_SSL=true
IMAP_MAILBOX=INBOX

# GLOB Configuration (if using glob provider — imports local .eml files instead of a live mailbox)
# Comma-separated glob patterns, e.g.:
# GLOB_PATTERNS=example-data/emails/*.eml,/path/to/more/*.eml
GLOB_PATTERNS=
