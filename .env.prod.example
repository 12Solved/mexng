# Postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mailextractor
DATABASE_URL=postgresql+psycopg2://admin:change_me@db/mailextractor
FILE_EXTRACT_PATH=/

# CORS — comma-separated list of allowed origins (not needed if using nginx proxy)
CORS_ORIGINS=http://your-domain.com


# Base path for the frontend must have leading and trailing slash
# Use / to serve from the root, or /subdir/ to serve from a subdirectory
# Example: BASE_PATH=/something/ -> app lives at www.example.com/something/
BASE_PATH=/{something}/
VITE_BASE_PATH=/{something}/

# Email Provider (imap or glob)
EMAIL_PROVIDER=imap

# Poller checkpoint file — must live under the ./data bind mount (see
# docker-compose.prod.yml) so it survives container redeploys.
CHECKPOINT_PATH=/app/data/checkpoint.txt

# IMAP Configuration
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_USE_SSL=true
IMAP_MAILBOX=INBOX
